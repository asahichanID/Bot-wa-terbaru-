# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# WhatsApp Bot Configuration (Pterodactyl & Node 20)
BOT_NAME="Oguri Cap"
BOT_PREFIX="."
WA_ENGINE="baileys"
SESSION_DIR="./data/session"
DATABASE_PATH="./data/database.json"
MAX_RECONNECT_ATTEMPTS=10
RECONNECT_BASE_DELAY_MS=3000
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=5000
ADMIN_NUMBERS="628123456789"
# PAIRING_NUMBER: (Optional) Nomor WA untuk Pairing Code di Pterodactyl (misal: 628123456789)
PAIRING_NUMBER=""
PORT=3000
NODE_ENV="production"

